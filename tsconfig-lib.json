{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "jsx": "react",
    "moduleResolution": "node",
    "pretty": true,
    "resolveJsonModule": true,
    "strict": true,
    "lib": ["dom", "ES2015", "ES2017", "es2020.string", "es2018.regexp"],
    "module": "ES2020",
    "outDir": "dist/lib",
    "target": "ES2020"
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/lib/monorail.ts"]
}
